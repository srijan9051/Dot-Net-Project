<?xml version="1.0" encoding="utf-8"?>
<Mapping Space="C-S" xmlns="http://schemas.microsoft.com/ado/2009/11/mapping/cs">
  <EntityContainerMapping StorageEntityContainer="IceCreamParlourModelStoreContainer" CdmEntityContainer="IceCreamParlourEntities">
    <EntitySetMapping Name="Items">
      <EntityTypeMapping TypeName="IceCreamParlourModel.Item">
        <MappingFragment StoreEntitySet="Item">
          <ScalarProperty Name="Id" ColumnName="Id" />
          <ScalarProperty Name="ItemName" ColumnName="ItemName" />
          <ScalarProperty Name="ItemFlavour" ColumnName="ItemFlavour" />
          <ScalarProperty Name="Price" ColumnName="Price" />
          <ScalarProperty Name="Image" ColumnName="Image" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="loginNews">
      <EntityTypeMapping TypeName="IceCreamParlourModel.loginNew">
        <MappingFragment StoreEntitySet="loginNew">
          <ScalarProperty Name="Id" ColumnName="Id" />
          <ScalarProperty Name="UserName" ColumnName="UserName" />
          <ScalarProperty Name="Email" ColumnName="Email" />
          <ScalarProperty Name="Password" ColumnName="Password" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="orderts">
      <EntityTypeMapping TypeName="IceCreamParlourModel.ordert">
        <MappingFragment StoreEntitySet="ordert">
          <ScalarProperty Name="ord_id" ColumnName="ord_id" />
