@model IEnumerable<IcecreamParlourSystem.Models.Item>
@{
    ViewBag.Title = "Home Page";
}

<style>
    /*body {
        background-color: #dfc1c6;
    }*/
    .design {
        font-family: "Dancing Script", cursive;
        font-size: 2.5rem;
        color: #e9d12a;
    }

    .lead {
        font-family: "Permanent Marker", cursive;
        font-size: 1.4rem;
        color:white;
    }
    .title {
        color: #e4ff00;
        font-family: cursive;
    }
    .img-fluid {
        font-family: cursive;
        display:inline;
    }

    .flip-card {
        background-color: transparent;
        width: 316px;
        height: 299px;
        perspective: 1000px;
        margin: 2px 20px;

        border-radius: 7px;
        box-shadow: 3px 3px 4px 9px 9px black;
    }

    /* This container is needed to position the front and back side */
    .flip-card-inner {
        position: relative;
        width: 100%;
        height: 100%;
        text-align: center;
        transition: transform 0.8s;
        transform-style: preserve-3d;
    }

    /* Do an horizontal flip when you move the mouse over the flip box container */
    .flip-card:hover .flip-card-inner {
        transform: rotateY(180deg);

    }

    /* Position the front and back side */
    .flip-card-front, .flip-card-back {
        position: absolute;
        width: 100%;
        height: 100%;
        -webkit-backface-visibility: hidden; /* Safari */
        backface-visibility: hidden;
    }

    /* Style the front side (fallback if image is missing) */
    .flip-card-front {
        background-color:pink;
        color: black;
    }

    /* Style the back side */
    .flip-card-back {
        background-color: #5dd1a1bd;
        color: black;
        transform: rotateY(180deg);
    }
    img {
        width: 294px;
        height: 295px;
        border-radius: 7px;
    }
    .dark {
        background-color: #00000096;
    }
    .btn-pos {
        position: absolute;
        top: 219px;
        left: 265px;
    }
    .btn-pos1 {
        position: absolute;
        top: 219px;
        left: 409px;
    }
    .btn-pos2 {
        position: absolute;
        top: 219px;
        left: 561px;
    }
    
    .font-change {
        font-family: "Dancing Script", cursive;
    }
</style>

<main>
    <section class="row dark" aria-labelledby="aspnetTitle">
        <h1 id="title" class="title">Frosty Delight</h1>
        <p class="lead">We Provide Delicious taste in all types of Icecream in <span class="design">Frosty Delight</span></p>
        <p><a href="../Items/Create" class="btn btn-success btn-md">Add New Item</a></p>
        <p><a href="../Items/Index" class="btn btn-success btn-pos">View Products</a></p>
        <p><a href="../Account/Index" class="btn btn-success btn-pos1">See Master List</a></p>
        <p><a href="../Cart/FinalOrders" class="btn btn-success btn-pos2">See Orders</a></p>
    </section>

    <div class="row">
        @foreach (var item in Model)
        {
        <div class="flip-card">
            <div class="flip-card-inner">
                <div class="flip-card-front">
                    <img src="@Url.Content(item.Image)" alt="@item.ItemName">
                </div>
                <div class="flip-card-back">
                    <h1 class="font-change">@item.ItemName</h1>
                    <h3>Flavour: @item.ItemFlavour</h3>
                    <h3>Price: @item.Price</h3>
                    <h3>Available</h3>
                    @Html.ActionLink("Edit Item", "Edit","Items", new { id = item.Id }, new { @class = "btn btn-success" })
                </div>
            </div>
           </div>
        }
        </div>
</main>

<script>
    window.addEventListener('pageshow', function (event) {
        if (event.persisted) {
            location.reload(true);
        }
    });
</script>