@{
    Layout = null;
}
@{
    ViewBag.Title = "Begin";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Frosty Delight</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    @*<link rel="stylesheet" href="~/Dumps/style.css" />
        <link rel="stylesheet" href="~/Dumps/style1.css" />*@
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400..700&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400..700&display=swap" rel="stylesheet">
    <style>
        .design1 {
            position: absolute;
            top: 12px;
            left: 5px;
            font-family: "Dancing Script", cursive;
            color: white;
            font-size: 1.3rem;
        }

        video {
            width: 95vw;
            height: 95vh;
        }

        .stateb {
            position: absolute;
            top: 120px;
            left: 210px;
            color: white;
        }

        .stateb1 {
            position: absolute;
            top: 170px;
            left: 81px;
            color: white;
        }

        .stateb2 {
            position: absolute;
            top: 199px;
            left: 190px;
            color: white;
        }

        .containerb {
            position: absolute;
            top: 120px;
            left: 207px;
            width: 65%;
            height: 72%;
            background-color: #0000007d;
        }

        .leadd {
            font-family: "Dancing Script", cursive;
            font-size: 2.4rem;
            margin-left:10%;
        }

        .leadd1 {
            font-family: cursive;
            font-size: 1.5rem;
            position: absolute;
            top: 44%;
            left: 20%;
            color: white;
        }

        .know {
            position: absolute;
            top: 239px;
            left: 296px;
            color: white;
            text-decoration: none;
            padding: 13px 18px;
            border: 1px solid black;
            border-radius: 7px;
            background-color: #dd0505a3;
            color: white;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

            .know:hover {
                cursor: pointer;
                box-shadow: 9px 5px 7px 5px black;
                color: white;
            }

        a {
            text-decoration: none;
            color: #ffffffb3;
        }

            a:hover {
                color: white;
            }

        .right {
            position: absolute;
            top: 18px;
            left: 84%;
            text-decoration: none;
            color: white;
        }

            .right a {
                margin: 0px 8px;
            }
    </style>
</head>
<body>
    <video autoplay loop muted plays-block id="background-clip">
        <source src="~/Dumps/bg_vid.mp4" type="video/mp4">
    </video>
    <div class="containerb">
        <h2 class="stateb leadd">Entry Restricted</h2>
        <h3 class="leadd1">You are not an admin or previous session is still active</h3>

    </div>
    <script>
        window.addEventListener('pageshow', function (event) {
            if (event.persisted) {
                location.reload(true);
            }
        });
    </script>

</body>
</html>

